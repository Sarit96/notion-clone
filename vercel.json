{
    "version": 2,
    "builds": [
        {
            "src": "server/server.ts",
            "use": "@vercel/node",
            "config": {
                "buildCommand": "cd server && npm install && npm run build",
                "outputDirectory": "dist"
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "server/dist/server.js"
        }
    ]
}